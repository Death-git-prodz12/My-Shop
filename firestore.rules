rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      allow read: if isOwner();
      // Les écritures de veille passent par une transaction serveur qui vérifie le plafond de 30.
      allow create, update, delete: if false;
      match /watchlist/{productId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if false;
      }
    }

    // Le catalogue synchronisé est uniquement accessible aux fonctions serveur (Admin SDK).
    match /catalogProducts/{productId} {
      allow read, write: if false;
    }
  }
}
