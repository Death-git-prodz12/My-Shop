# Copier ces variables dans Netlify > Site configuration > Environment variables.
# Ne jamais mettre de valeurs réelles dans js/config.js ni dans le dépôt.
FIREBASE_PROJECT_ID=myshop-10
FIREBASE_SERVICE_ACCOUNT_JSON=

# Amazon Creators API (l'ancienne PA-API 5 est dépréciée)
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_VERSION=3.1
AMAZON_CREATORS_REGION=NA
AMAZON_MARKETPLACE=www.amazon.com
AMAZON_PARTNER_TAG=
# Requêtes séparées par |, ex. accessoires cuisine|lampe bureau
AMAZON_SEARCH_KEYWORDS=

# AliExpress Open Platform: renseigner une méthode permise à votre application.
ALIEXPRESS_ENDPOINT=https://api-sg.aliexpress.com/sync
ALIEXPRESS_API_PATH=/sync
ALIEXPRESS_API_METHOD=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REQUEST_PARAMS_JSON={}

# Feeds JSON autorisés que votre compte/partenaire vous permet d'utiliser.
# Les identifiants sont conservés côté serveur et transmis en Bearer.
TEMU_FEED_URL=
TEMU_FEED_TOKEN=
SHEIN_FEED_URL=
SHEIN_FEED_TOKEN=
ALIBABA_FEED_URL=
ALIBABA_FEED_TOKEN=
SHOPIFY_FEED_URL=
SHOPIFY_FEED_TOKEN=
TIKTOK_FEED_URL=
TIKTOK_FEED_TOKEN=
CJ_FEED_URL=
CJ_FEED_TOKEN=

PROVIDER_TIMEOUT_MS=6500
# Flux JSON publics sans authentification; URL de chaque feed fournie par l'administrateur.
# Format: [{"platform":"Shopify","url":"https://..."}]
PUBLIC_PRODUCT_FEEDS_JSON=[]
# Shopify Ajax API publique (sans clé), à partir de fiches produits connues.
# Format: ["https://votre-boutique.com/products/handle"]
SHOPIFY_PUBLIC_PRODUCT_URLS=[]
SHOPIFY_PUBLIC_CURRENCY=
